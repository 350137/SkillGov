{
  "name": "skillgov",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop:dev": "corepack pnpm --filter @skillgov/desktop dev",
    "desktop:test": "corepack pnpm --filter @skillgov/desktop test",
    "desktop:local-exe": "powershell -ExecutionPolicy Bypass -File scripts/desktop/build-local-exe.ps1",
    "descriptions:generate": "tsx scripts/skill-descriptions/generate-description-table.ts",
    "descriptions:export": "tsx scripts/skill-descriptions/export-translation-worklist.ts",
    "descriptions:apply": "tsx scripts/skill-descriptions/apply-translation-csv.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "pnpm --filter @skillgov/control-panel build:spa && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
