// TypeScript config for the control panel React SPA — JSX support, path aliases, bundler resolution.
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src", "server.ts", "vite.config.ts"]
}
