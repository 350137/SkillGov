# Defines which local SkillGov runtime files, dependency folders, build outputs, and secrets must not be uploaded to GitHub.

# Dependency directories
node_modules/
.pnpm-store/

# TypeScript / JavaScript build outputs
dist/
build/
out/
.next/
.vite/
coverage/
*.tsbuildinfo
target/
apps/desktop/src-tauri/gen/

# Logs and temporary files
*.log
logs/
tmp/
temp/
.cache/
.turbo/
.codegraph/

# Environment files and local secrets
.env
.env.*
!.env.example
*.local

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# SkillGov local runtime data
incoming/
skills/
overlays/
reports/
backups/

# SkillGov local registry and machine-specific config
registry/*.json
registry/*.jsonl
registry/*.tmp
skillgov.config.json
!skillgov.config.example.json

# Generated AI repair or overlay tasks may contain local paths or private skill content
tasks/repair/
tasks/overlay/

# Local AI tool project settings
.claude/

# Local UI/server state
.skillgov/
.skillgov-*/
*.pid

# Python extension caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
